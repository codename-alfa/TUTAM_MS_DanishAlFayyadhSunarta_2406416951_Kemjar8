# Neon Database Connection String
# Ambil connection string dari Neon Dashboard (Dashboard -> Connection Details -> Connection string -> Prisma/Node.js/psql)
# Format: postgresql://[user]:[password]@[endpoint_host]/[database]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-xxxxxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Mode Environment:
# - 'production' : Menggunakan driver @neondatabase/serverless (NeonPool & neon template tag)
# - 'development': Menggunakan driver standar 'pg' (PgPool)
NODE_ENV=production
